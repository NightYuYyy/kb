api:
  # 向量 / embedding（硅基流动）
  base_url: https://api.siliconflow.cn/v1
  api_key: sk-your-key-here
  embedding_model: BAAI/bge-m3
  # LLM（可选独立配置，不配则复用上面 base_url/api_key）
  # llm_base_url: https://api.deepseek.com
  # llm_api_key: sk-your-deepseek-key
  llm_model: deepseek-ai/DeepSeek-V3

storage:
  db_path: data/kb.db

server:
  host: 0.0.0.0
  port: 8765
  # 必填：API 认证 token，用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成
  auth_token: ""
  # 旧版 public_url 无需再设置：「复制提示词」使用当前浏览器访问地址。
